{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "themes/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @knowva/theme-default",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "preview": "npm run preview --workspace @knowva/theme-default"
  }
}

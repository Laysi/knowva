# Copied to ~/knowva/.env on the Mac mini; docker-compose.yml reads it.
# Never commit a populated copy.

KNOWVA_VERSION=v0.5.0
# openssl rand -hex 24
POSTGRES_PASSWORD=

# Chosen on this machine by bench/chat.ts: see README.md.
GEMMA_4_MODEL_ID=gemma4:12b-it-qat

# Defaults kept from docker-compose.prod.yml. The Mac answers more slowly
# than a GPU server, so the per-request timeout is wider.
RERANK_CANDIDATE_TOP_K=50
RERANK_TOP_N=6
RERANK_BATCH_SIZE=8
MODEL_REQUEST_TIMEOUT_SECS=300
PDF_RENDER_DPI=180

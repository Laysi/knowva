DATABASE_URL=postgres://knowva:knowva@localhost:5432/knowva
FILES_DIR=./data/files
PORT=8080
# Docker Compose host ports. The app still listens on PORT=8080 inside its container.
APP_PORT=8080
POSTGRES_PORT=5432

# Industry profile, read once at startup from PROFILES_DIR/<KNOWVA_PROFILE>:
# profile.json (frontend theme, interface copy, suggested questions, catalog
# keywords) and prompt.md (industry section appended after the core answer
# rules, at most 2,000 characters). The backend serves the profile's theme from
# ../frontend/dist/<theme>. A missing or invalid profile, or a frontend build
# without that theme, stops startup. Empty values mean the defaults.
KNOWVA_PROFILE=default
# Relative to backend/ (default ../profiles). The Docker image ships every
# profile at that path, so containers leave this unset.
PROFILES_DIR=

# File storage backend for originals, page images, converted PDFs and manifests.
#   local (default): FILES_DIR on the local filesystem.
#   s3: an S3-compatible bucket (AWS S3, Cloudflare R2, MinIO).
# The first start against an empty database records the backend (and, for s3,
# the bucket and prefix); later starts with a different value refuse to run.
# Changing it requires re-initializing both the database and the storage.
# FILES_DIR and the S3 endpoint are not locked and may move.
STORAGE_BACKEND=local
# Required for s3. STORAGE_PREFIX is optional, e.g. tenant-a/prod.
STORAGE_BUCKET=
STORAGE_PREFIX=
# s3 endpoint, region and credentials; empty values count as unset.
#   STORAGE_ENDPOINT    R2/MinIO only, e.g. https://<account_id>.r2.cloudflarestorage.com
#   STORAGE_REGION      AWS region (default us-east-1); Cloudflare R2: auto
#   STORAGE_ACCESS_KEY_ID / STORAGE_SECRET_ACCESS_KEY
#                       leave empty to use an IAM role or instance/container
#                       credentials, discovered through the platform's AWS_* variables
#   STORAGE_ALLOW_HTTP  true only for a plain-HTTP endpoint such as local MinIO
#   STORAGE_TIMEOUT     per-request timeout (default 30s), e.g. 120s for slow uplinks
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ALLOW_HTTP=
STORAGE_TIMEOUT=
# Local MinIO via `docker compose --profile minio up -d minio minio-init`:
#   host backend: STORAGE_ENDPOINT=http://localhost:9000
#   compose app:  STORAGE_ENDPOINT=http://minio:9000
#   STORAGE_ACCESS_KEY_ID=knowvaminio, STORAGE_SECRET_ACCESS_KEY=knowvaminio-secret, STORAGE_BUCKET=knowva-files
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Model-free document preprocessing. Pdfium is required for PDF/Office page
# rendering; LibreOffice is only required for DOCX/PPTX/XLSX uploads.
PDF_RENDER_DPI=180
DOCUMENT_CONVERSION_TIMEOUT_SECS=120
# Optional full path to libpdfium, or a directory containing the platform library.
# Empty means search beside the executable and then the system library path.
PDFIUM_LIBRARY_PATH=
LIBREOFFICE_BIN=libreoffice

# On-premise model connectivity. The backend talks to a self-hosted inference
# service over plain HTTP(S): OpenAI-compatible chat/embeddings routes and the
# NVIDIA ranking route, with the model id in each request body.
# Base URL of the inference service, without a trailing route, e.g.
# http://inference-host:8000. Required unless all three MODEL_*_URL below are
# set. Derived routes: v1/chat/completions, v1/embeddings, v1/ranking.
MODEL_BASE_URL=
# Optional bearer token. Empty means the service is unauthenticated and no
# Authorization header is sent. Never commit a populated .env file.
MODEL_API_TOKEN=

# Model IDs are sent in the request body; endpoint URLs contain only the
# service operation route.
GEMMA_4_MODEL_ID=

# Embedding and rerank model IDs are sent in their request bodies.
NEMOTRON_EMBED_MODEL_ID=nvidia/llama-nemotron-embed-vl-1b-v2
NEMOTRON_RERANK_MODEL_ID=nvidia/llama-nemotron-rerank-vl-1b-v2

# Top dense candidates sent to Rerank VL, final context size, and passages per
# request. RERANK_TOP_N is restricted to 3-8 and may not exceed the candidate
# count; batch size is at most 512; all values must be positive.
RERANK_CANDIDATE_TOP_K=20
RERANK_TOP_N=6
RERANK_BATCH_SIZE=8

# false skips Rerank VL and sends the first RERANK_TOP_N dense candidates to
# Gemma. The rerank model is then never loaded, which saves memory on a small
# machine at the cost of missed sources (docs/measurements §8.16).
RERANK_ENABLED=true

# Full-URL overrides are independent, so chat, embedding and rerank can each
# live on their own host, which is the usual on-premise layout (chat on one GPU
# node, the two Nemotron NIMs on another). A set value replaces the route
# derived from MODEL_BASE_URL; switching services only changes the URL.
#   MODEL_CHAT_URL=http://chat-host:8000/v1/chat/completions
#   MODEL_EMBED_URL=http://embed-host:8000/v1/embeddings
#   MODEL_RERANK_URL=http://rerank-host:8000/v1/ranking
MODEL_CHAT_URL=
MODEL_EMBED_URL=
MODEL_RERANK_URL=

# Positive integer applied to every model request and SSE response stream.
MODEL_REQUEST_TIMEOUT_SECS=120

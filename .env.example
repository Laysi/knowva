DATABASE_URL=postgres://km:km@localhost:5432/km
FILES_DIR=./data/files
PORT=8080
# Docker Compose host ports. The app still listens on PORT=8080 inside its container.
APP_PORT=8080
POSTGRES_PORT=5432

# Model-free document preprocessing. Pdfium is required for PDF/Office page
# rendering; LibreOffice is only required for DOCX/PPTX/XLSX uploads.
PDF_RENDER_DPI=180
DOCUMENT_CONVERSION_TIMEOUT_SECS=120
# Optional full path to libpdfium, or a directory containing the platform library.
# Empty means search beside the executable and then the system library path.
PDFIUM_LIBRARY_PATH=
LIBREOFFICE_BIN=libreoffice

# Cloud model API credentials. Required; never commit a populated .env file.
NVIDIA_API_KEY=

# Required. Enter the exact Gemma 4 model ID confirmed by your cloud endpoint.
# This repository intentionally does not guess or fall back to another model family.
GEMMA_4_MODEL_ID=

# Locked MVP retrieval model families. Vendor-qualified IDs are accepted.
NEMOTRON_EMBED_MODEL_ID=nvidia/llama-nemotron-embed-vl-1b-v2
NEMOTRON_RERANK_MODEL_ID=nvidia/llama-nemotron-rerank-vl-1b-v2

# Common cloud API base. Chat and embedding use the standard paths below by default.
CLOUD_MODEL_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional full-URL overrides when the three cloud capabilities use different endpoints.
# Empty means ${CLOUD_MODEL_BASE_URL}/chat/completions or /embeddings respectively.
CLOUD_CHAT_URL=
CLOUD_EMBED_URL=
# NVIDIA's hosted VL reranking endpoint does not share the common base URL.
CLOUD_RERANK_URL=https://ai.api.nvidia.com/v1/retrieval/nvidia/llama-nemotron-rerank-vl-1b-v2/reranking

# Positive integer applied to every cloud model request and SSE response stream.
CLOUD_MODEL_REQUEST_TIMEOUT_SECS=120

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
BEDROCK_CHAT_MODEL_ID=us.amazon.nova-2-lite-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
DATABASE_URL=postgres://km:km@localhost:5432/km
FILES_DIR=./data/files
PORT=8080

# 模型供應商:bedrock 或 nvidia(改完重啟後端生效)
MODEL_PROVIDER=bedrock

# NVIDIA Build(build.nvidia.com)設定,MODEL_PROVIDER=nvidia 時使用
# API key 到 build.nvidia.com 申請,nvapi- 開頭
NVIDIA_API_KEY=
NVIDIA_CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b
# 必須是 1024 維模型,否則和 DB schema vector(1024) 不合
NVIDIA_EMBED_MODEL=nvidia/llama-nemotron-embed-1b-v2
# 非原生 1024 維的模型用 Matryoshka 降維;原生 1024 維(如 nv-embedqa-e5-v5)請留空
NVIDIA_EMBED_DIMENSIONS=1024
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

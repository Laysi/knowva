DATABASE_URL=postgres://km:km@localhost:5432/km
FILES_DIR=./data/files
PORT=8080
# Docker Compose host ports. The app still listens on PORT=8080 inside its container.
APP_PORT=8080
POSTGRES_PORT=5432

# File storage backend for originals, page images, converted PDFs and manifests.
#   local (default): FILES_DIR on the local filesystem.
#   s3: an S3-compatible bucket (AWS S3, Cloudflare R2, MinIO).
# The first start against an empty database records the backend (and, for s3,
# the bucket and prefix); later starts with a different value refuse to run.
# Changing it requires re-initializing both the database and the storage.
# FILES_DIR and the S3 endpoint are not locked and may move.
STORAGE_BACKEND=local
# Required for s3. STORAGE_PREFIX is optional, e.g. tenant-a/prod.
STORAGE_BUCKET=
STORAGE_PREFIX=
# s3 endpoint, region and credentials; empty values count as unset.
#   STORAGE_ENDPOINT    R2/MinIO only, e.g. https://<account_id>.r2.cloudflarestorage.com
#   STORAGE_REGION      AWS region (default us-east-1); Cloudflare R2: auto
#   STORAGE_ACCESS_KEY_ID / STORAGE_SECRET_ACCESS_KEY
#                       leave empty to use an IAM role or instance/container
#                       credentials, discovered through the platform's AWS_* variables
#   STORAGE_ALLOW_HTTP  true only for a plain-HTTP endpoint such as local MinIO
#   STORAGE_TIMEOUT     per-request timeout (default 30s), e.g. 120s for slow uplinks
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ALLOW_HTTP=
STORAGE_TIMEOUT=
# Local MinIO via `docker compose --profile minio up -d minio minio-init`:
#   host backend: STORAGE_ENDPOINT=http://localhost:9000
#   compose app:  STORAGE_ENDPOINT=http://minio:9000
#   STORAGE_ACCESS_KEY_ID=kmminio, STORAGE_SECRET_ACCESS_KEY=kmminio-secret, STORAGE_BUCKET=km-files
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Model-free document preprocessing. Pdfium is required for PDF/Office page
# rendering; LibreOffice is only required for DOCX/PPTX/XLSX uploads.
PDF_RENDER_DPI=180
DOCUMENT_CONVERSION_TIMEOUT_SECS=120
# Optional full path to libpdfium, or a directory containing the platform library.
# Empty means search beside the executable and then the system library path.
PDFIUM_LIBRARY_PATH=
LIBREOFFICE_BIN=libreoffice

# Cloud model connectivity. All model traffic is routed through a Cloudflare
# AI Gateway and the backend holds no provider API keys: provider keys live in
# the gateway's BYOK store, so requests carry only the gateway token below and
# never an upstream Authorization header.
# Setup order (dash.cloudflare.com -> AI -> AI Gateway):
#   1. Create a gateway; note the account id and gateway id.
#   2. Enable Authenticated Gateway (BYOK requires it) and create an AI
#      Gateway token with Run permission -> CF_AI_GATEWAY_TOKEN. Any Run token
#      in the account can use the gateway and its stored keys.
#   3. Register two custom providers used by the default routes further below:
#        slug nvidia-build -> base URL https://integrate.api.nvidia.com
#        slug nvidia-ai    -> base URL https://ai.api.nvidia.com
#   4. Store the NVIDIA Build API key via BYOK for both custom providers (and
#      an OpenRouter key for the openrouter provider if chat uses that route).
#      The key with the default alias is used; the backend does not send
#      cf-aig-byok-alias.
# Required unless all three CLOUD_*_URL overrides below are set. Shape:
#   https://gateway.ai.cloudflare.com/v1/<account_id>/<gateway_id>
CF_AI_GATEWAY_BASE_URL=
# Required AI Gateway "Run" token, the backend's only secret. Sent as
# `cf-aig-authorization: Bearer ...` with every model request.
# Never commit a populated .env file.
CF_AI_GATEWAY_TOKEN=

# Model IDs are sent in the request body; endpoint URLs contain only the
# provider operation route.
GEMMA_4_MODEL_ID=

# Embedding and rerank model IDs are sent in their request bodies.
NEMOTRON_EMBED_MODEL_ID=nvidia/llama-nemotron-embed-vl-1b-v2
NEMOTRON_RERANK_MODEL_ID=nvidia/llama-nemotron-rerank-vl-1b-v2

# Hybrid RRF candidates sent to Rerank VL, final context size, and passages per
# hosted request. RERANK_TOP_N is restricted to 3-8; batch size is at most 512;
# all values must be positive.
RERANK_CANDIDATE_TOP_K=50
RERANK_TOP_N=6
RERANK_BATCH_SIZE=8

# Full-URL overrides are independent, so chat, embedding, and rerank can each
# use a different provider. Provider switching is done by changing the complete
# URL; no SDK or provider-specific code is required:
#   CLOUD_CHAT_URL=${CF_AI_GATEWAY_BASE_URL}/custom-nvidia-build/chat/completions
#   CLOUD_EMBED_URL=${CF_AI_GATEWAY_BASE_URL}/custom-nvidia-build/embeddings
#   CLOUD_RERANK_URL=${CF_AI_GATEWAY_BASE_URL}/custom-nvidia-ai/retrieval/nvidia/llama-nemotron-rerank-vl-1b-v2/reranking
# Empty means the defaults derived from CF_AI_GATEWAY_BASE_URL:
#   chat   ${CF_AI_GATEWAY_BASE_URL}/custom-nvidia-build/chat/completions
#   embed  ${CF_AI_GATEWAY_BASE_URL}/custom-nvidia-build/embeddings
#   rerank ${CF_AI_GATEWAY_BASE_URL}/custom-nvidia-ai/retrieval/nvidia/llama-nemotron-rerank-vl-1b-v2/reranking
# Chat via OpenRouter (store the OpenRouter key via BYOK first):
#   CLOUD_CHAT_URL=${CF_AI_GATEWAY_BASE_URL}/openrouter/v1/chat/completions
# Chat via Amazon Bedrock: store AWS credentials in the gateway via BYOK (the
# gateway signs SigV4) and use the OpenAI-compatible unified route
#   CLOUD_CHAT_URL=${CF_AI_GATEWAY_BASE_URL}/compat/chat/completions
# with GEMMA_4_MODEL_ID=aws-bedrock/<bedrock gemma-4 model id>. This matches
# the keyless-backend design, but Bedrock currently hosts no Gemma 4 model,
# so the route stays theoretical for the locked MVP.
CLOUD_CHAT_URL=
CLOUD_EMBED_URL=
CLOUD_RERANK_URL=

# Positive integer applied to every cloud model request and SSE response stream.
CLOUD_MODEL_REQUEST_TIMEOUT_SECS=120

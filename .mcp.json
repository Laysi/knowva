{
  "mcpServers": {
    "mcp-docs-server": {
      "command": "npx",
      "args": [
        "-y",
        "@assistant-ui/mcp-docs-server"
      ]
    },
    "aws-api": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "awslabs.aws-api-mcp-server@latest"
      ],
      "env": {
        "AWS_REGION": "us-east-2"
      }
    },
    "cloudflare-api": {
      "type": "http",
      "url": "https://mcp.cloudflare.com/mcp"
    }
  }
}